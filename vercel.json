{
  "functions": {
    "api/whatsapp.js": {
      "maxDuration": 120,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/form.js": {
      "maxDuration": 120,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/cron-followup.js": {
      "maxDuration": 300,
      "includeFiles": "api/_lib/fonts/**"
    },
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/fonts/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron-followup",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-followup?taak=voorraad",
      "schedule": "30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(faro|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(logo|logo-ink|favicon)\\.(webp|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(promo|social|onboard|404|500)(\\.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.helvaro.pro"
        }
      ],
      "destination": "https://helvaro.pro/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "has": [
        {
          "type": "host",
          "value": "www.helvaro.pro"
        }
      ],
      "destination": "https://app.helvaro.pro/dashboard",
      "permanent": true
    },
    {
      "source": "/dashboard/:pad*",
      "has": [
        {
          "type": "host",
          "value": "www.helvaro.pro"
        }
      ],
      "destination": "https://app.helvaro.pro/dashboard/:pad*",
      "permanent": true
    },
    {
      "source": "/:pad*",
      "has": [
        {
          "type": "host",
          "value": "www.helvaro.pro"
        }
      ],
      "destination": "https://helvaro.pro/:pad*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/onboard",
      "destination": "/onboard.html"
    },
    {
      "source": "/promo",
      "destination": "/promo.html"
    },
    {
      "source": "/social",
      "destination": "/social.html"
    },
    {
      "source": "/dashboard",
      "destination": "/api/dashboard"
    },
    {
      "source": "/dashboard.css",
      "destination": "/api/dashboard?asset=css"
    },
    {
      "source": "/dashboard.js",
      "destination": "/api/dashboard?asset=js"
    },
    {
      "source": "/login",
      "destination": "/api/dashboard"
    },
    {
      "source": "/signup",
      "destination": "/api/dashboard"
    },
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/privacy"
    },
    {
      "source": "/forgot-password",
      "destination": "/api/auth"
    },
    {
      "source": "/reset-password",
      "destination": "/api/auth"
    },
    {
      "source": "/verify-email",
      "destination": "/api/auth"
    },
    {
      "source": "/demo",
      "destination": "/api/demo"
    },
    {
      "source": "/form-widget.js",
      "destination": "/public/form-widget.js"
    },
    {
      "source": "/ai-demo.js",
      "destination": "/public/ai-demo.js"
    },
    {
      "source": "/assistant.js",
      "destination": "/public/assistant.js"
    },
    {
      "source": "/OneSignalSDKWorker.js",
      "destination": "/public/OneSignalSDKWorker.js"
    },
    {
      "source": "/favicon.png",
      "destination": "/public/favicon.png"
    },
    {
      "source": "/api/gcal",
      "destination": "/api/leads?__gcal=1"
    },
    {
      "source": "/api/ai-demo",
      "destination": "/api/whatsapp?__demo=1"
    },
    {
      "source": "/api/assistant",
      "destination": "/api/form?__assistant=1"
    },
    {
      "source": "/api/inventory/:code/:vehicle",
      "destination": "/api/form?__voorraad=1"
    },
    {
      "source": "/api/inventory/:code",
      "destination": "/api/form?__voorraad=1"
    },
    {
      "source": "/api/form/:code",
      "destination": "/api/form"
    },
    {
      "source": "/start/:code/:pand",
      "destination": "/api/form-page"
    },
    {
      "source": "/start/:code",
      "destination": "/api/form-page"
    },
    {
      "source": "/start",
      "destination": "/api/form-page"
    }
  ]
}
