{
  "functions": {
    "api/whatsapp.js":      { "maxDuration": 120, "includeFiles": "api/lib/fonts/**" },
    "api/form.js":          { "maxDuration": 120, "includeFiles": "api/lib/fonts/**" },
    "api/cron-followup.js": { "maxDuration": 300, "includeFiles": "api/lib/fonts/**" },
    "api/**/*.js":          { "maxDuration": 60,  "includeFiles": "api/lib/fonts/**" }
  },
  "crons": [
    { "path": "/api/cron-followup", "schedule": "0 9 * * *" }
  ],
  "redirects": [
    { "source": "/", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/onboard", "destination": "/onboard.html" },
    { "source": "/promo",   "destination": "/promo.html"   },
    { "source": "/social",  "destination": "/social.html"  },
    { "source": "/dashboard",                       "destination": "/api/dashboard" },
    { "source": "/privacy",        "destination": "/api/privacy" },
    { "source": "/terms",          "destination": "/api/privacy" },
    { "source": "/forgot-password","destination": "/api/auth" },
    { "source": "/reset-password", "destination": "/api/auth" },
    { "source": "/demo",           "destination": "/api/demo" },
    { "source": "/form-widget.js", "destination": "/public/form-widget.js" },
    { "source": "/favicon.png",    "destination": "/public/favicon.png" },
    { "source": "/api/gcal",       "destination": "/api/leads?__gcal=1" },
    { "source": "/api/form/:code", "destination": "/api/form" },
    { "source": "/start/:code",    "destination": "/api/form-page" },
    { "source": "/start",          "destination": "/api/form-page" }
  ]
}
